{
  "_comment": [
    "Cross-language contract for the TXT transcript writer.",
    "Read by python/whisperflow/tests/test_writers.py and by",
    "tests/unit/subtitle-writer.test.js, which compare their own output",
    "against `expected` byte for byte.",
    "",
    "HAND-WRITTEN ON PURPOSE. Generating it from either implementation",
    "would make it a snapshot of that side, so a regression there would",
    "quietly rewrite its own expectation. These values were worked out by",
    "hand from the rules and then confirmed against both implementations.",
    "",
    "Segments use the Python JSON shape (snake_case `speaker_label`); the",
    "JS test maps it to `speakerLabel` on load, exactly as",
    "src/main/transcript-reader.js does for real files."
  ],
  "paragraphGapSeconds": 2.0,
  "cases": [
    {
      "name": "one speaker, consecutive cues run together",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 2.0, "text": "First cue." },
        { "start": 2.0, "end": 4.0, "text": "Second cue." }
      ],
      "expected": "First cue. Second cue.\n"
    },
    {
      "name": "a speaker change starts a labelled paragraph",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 2.0, "text": "Hello there.", "speaker": 0, "speaker_label": "Speaker 1" },
        { "start": 2.0, "end": 4.0, "text": "Hi back.", "speaker": 1, "speaker_label": "Speaker 2" }
      ],
      "expected": "[Speaker 1] Hello there.\n\n[Speaker 2] Hi back.\n"
    },
    {
      "name": "a label carries only on the paragraph's first cue",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 2.0, "text": "One.", "speaker": 0, "speaker_label": "Speaker 1" },
        { "start": 2.0, "end": 4.0, "text": "Two.", "speaker": 0 },
        { "start": 4.0, "end": 6.0, "text": "Three.", "speaker": 0 }
      ],
      "expected": "[Speaker 1] One. Two. Three.\n"
    },
    {
      "name": "CJK cues join with no space between them",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "所以我們認為", "speaker": 0 },
        { "start": 1.0, "end": 2.0, "text": "這比較便宜。", "speaker": 0 }
      ],
      "expected": "所以我們認為這比較便宜。\n"
    },
    {
      "name": "a CJK to Latin boundary keeps its space",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "這個 API", "speaker": 0 },
        { "start": 1.0, "end": 2.0, "text": "very good", "speaker": 0 }
      ],
      "expected": "這個 API very good\n"
    },
    {
      "name": "a Latin to CJK boundary keeps its space",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "The result is", "speaker": 0 },
        { "start": 1.0, "end": 2.0, "text": "很好", "speaker": 0 }
      ],
      "expected": "The result is 很好\n"
    },
    {
      "name": "a cue's own line break is flattened to a space",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 2.0, "text": "line one\nline two", "speaker": 0 }
      ],
      "expected": "line one line two\n"
    },
    {
      "name": "the same speaker after a long pause starts an unlabelled paragraph",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "Before the pause.", "speaker": 0, "speaker_label": "Speaker 1" },
        { "start": 5.0, "end": 6.0, "text": "After the pause.", "speaker": 0 }
      ],
      "expected": "[Speaker 1] Before the pause.\n\nAfter the pause.\n"
    },
    {
      "name": "a gap exactly at the threshold does not break the paragraph",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "A.", "speaker": 0 },
        { "start": 3.0, "end": 4.0, "text": "B.", "speaker": 0 }
      ],
      "expected": "A. B.\n"
    },
    {
      "name": "a blank cue is skipped without breaking the paragraph",
      "paragraphs": true,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "First.", "speaker": 0 },
        { "start": 1.0, "end": 2.0, "text": "   ", "speaker": 0 },
        { "start": 2.0, "end": 3.0, "text": "Second.", "speaker": 0 }
      ],
      "expected": "First. Second.\n"
    },
    {
      "name": "no segments at all",
      "paragraphs": true,
      "segments": [],
      "expected": ""
    },
    {
      "name": "paragraphs off is one cue per line, unchanged",
      "paragraphs": false,
      "segments": [
        { "start": 0.0, "end": 2.0, "text": "First cue.", "speaker": 0, "speaker_label": "Speaker 1" },
        { "start": 2.0, "end": 4.0, "text": "Second cue.", "speaker": 0 }
      ],
      "expected": "[Speaker 1] First cue.\nSecond cue.\n"
    },
    {
      "name": "paragraphs off keeps a blank cue as a blank line",
      "paragraphs": false,
      "segments": [
        { "start": 0.0, "end": 1.0, "text": "First.", "speaker": 0 },
        { "start": 1.0, "end": 2.0, "text": "   ", "speaker": 0 }
      ],
      "expected": "First.\n\n"
    }
  ]
}
